# EJEMPLO DE CONFIGURACIÓN LOCAL — NO SE CARGA AUTOMÁTICAMENTE.
# Establecer variables en el proceso Python o en la unidad systemd.
# No subir tokens, claves privadas, bases de datos ni archivos personales a Git.

# FastAPI debe mantenerse en loopback; los iniciadores lo fijan explícitamente.
LOCALSYNC_API_HOST=127.0.0.1
LOCALSYNC_API_PORT=8080
LOCALSYNC_P2P_PORT=9001

# Arranque automático completo (solo en equipo autorizado):
# LOCALSYNC_AUTOSTART=1
# LOCALSYNC_AUTH_TOKEN=REEMPLAZAR_POR_TOKEN_SEGURO_COMPARTIDO_32_BYTES_O_MAS
# LOCALSYNC_SYNC_PEER=192.168.1.25
# LOCALSYNC_SYNC_PEER_PORT=9001

# Modo seguro por defecto: NO propagar eliminaciones.
LOCALSYNC_ALLOW_REMOTE_DELETE=0

# Directorios operativos por defecto en el repositorio.
# Para servicio systemd, usar rutas /var/lib/localsync/...
# LOCALSYNC_SYNC_DIR=/var/lib/localsync/shared
# LOCALSYNC_SYNC_DB=/var/lib/localsync/sync.db
# LOCALSYNC_VERSIONS_DIR=/var/lib/localsync/versions
# LOCALSYNC_UPLOAD_DIR=/var/lib/localsync/upload
# LOCALSYNC_RECEIVE_DIR=/var/lib/localsync/inbox

# TLS opcional en transmisiones (se debe verificar SAN del certificado):
# LOCALSYNC_TLS_CERT=/etc/localsync/servidor.crt
# LOCALSYNC_TLS_KEY=/etc/localsync/servidor.key
# LOCALSYNC_TLS_CA=/etc/localsync/certificado-del-par.crt
# LOCALSYNC_TLS_SERVER_NAME=192.168.1.25

# Metadatos del modelo inicial (independientes de la cola sync.db):
# LOCALSYNC_DB_PATH=/var/lib/localsync/localsync_meta.db
# LOCALSYNC_SCHEMA_PATH=/opt/localsync/src/bd/schema.sql

# Ruta heredada de compatibilidad (API antigua):
# LOCALSYNC_PAR_LAN=192.168.1.25
