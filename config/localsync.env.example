# Variables de entorno de referencia — LocalSync (NO se cargan automáticamente).
# Configurar en el proceso Python o en la unidad systemd; no subir secretos reales.
# Los iniciadores actuales del panel escuchan explícitamente en 127.0.0.1:8080.
LOCALSYNC_API_HOST=127.0.0.1
LOCALSYNC_API_PORT=8080
LOCALSYNC_P2P_PORT=9001

# Ruta de ejemplo Ubuntu (cambiar permisos y crear carpetas antes de usar):
LOCALSYNC_DB_PATH=/var/lib/localsync/localsync_meta.db

# Las siguientes opciones son referencias comentadas, no valores activos.
# LOCALSYNC_AUTH_TOKEN=<un_secreto_aleatorio_compartido_de_al_menos_16_caracteres>
# LOCALSYNC_TLS_CA=/ruta/certificado_receptor.crt
# LOCALSYNC_TLS_SERVER_NAME=192.168.1.25
# LOCALSYNC_PAR_LAN=192.168.1.25   # Solo API heredada /api/p2p

# Esta variable histórica no activa un motor de sincronización automática:
LOCALSYNC_DEMO_MODE=true
