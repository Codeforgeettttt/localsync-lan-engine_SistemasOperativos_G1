# LocalSync: servidor TCP como servicio Ubuntu independiente de FastAPI.
# Instalación prevista: /opt/localsync y /var/lib/localsync.
# Requiere /etc/localsync/localsync.env con LOCALSYNC_AUTH_TOKEN fuerte.
# Adaptar rutas y permisos antes de activar este servicio.
[Unit]
Description=LocalSync LAN TCP receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=localsync
Group=localsync
WorkingDirectory=/opt/localsync
Environment=PYTHONPATH=/opt/localsync
EnvironmentFile=/etc/localsync/localsync.env
ExecStart=/opt/localsync/.venv/bin/python3 -m src.backend.network.p2p_socket --host 0.0.0.0 --port 9001 --directory /var/lib/localsync/recibidos --on-conflict keep-both
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/localsync
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
