%% Arquitectura OPERATIVA LocalSync al 18-11-2026.
%% No hay sincronización automática. Cada lado puede emitir y recibir manualmente.
flowchart LR
  subgraph EquipoA["Equipo A"]
    UA["Navegador localhost:8080"]
    AP["FastAPI /api/lan"]
    CA["Cliente TCP"]
    RA["Receptor TCP :9001"]
    FSA[("Bandeja de archivos A")]
    DBA[("SQLite: esquema y utilidades; cola no conectada")]
    UA --> AP
    AP --> CA
    AP --> RA
    AP --> FSA
    AP -. "Diagnóstico" .-> DBA
  end
  subgraph RedLAN["LAN privada - HMAC; TLS configurable"]
    NET["Protocolo LOCALSYNC_P2P_V1\nJSON + bloques TCP"]
  end
  subgraph EquipoB["Equipo B"]
    RB["Receptor TCP :9001"]
    CH["Validación de ruta y SHA-256"]
    FSB[("Carpeta autorizada B")]
    RB --> CH --> FSB
  end
  CA --> NET --> RB
  RB -. "ACK o ERROR" .-> CA
  %% Para invertir la dirección, Equipo B actúa como emisor y Equipo A como receptor.
