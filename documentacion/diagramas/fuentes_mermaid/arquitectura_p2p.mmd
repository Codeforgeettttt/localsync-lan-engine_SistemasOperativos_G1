%% Arquitectura OPERATIVA LocalSync versión interna 0.4.0-sync
flowchart LR
  subgraph A["Equipo A"]
    GUIA["GUI localhost:8080"]
    SYNCA["Watchdog + escaneo"]
    DBA[("SQLite: cola + versiones")]
    TXA["Cliente TCP"]
    RXA["Receptor TCP"]
    FSA[("Carpeta A")]
    GUIA --> SYNCA
    FSA --> SYNCA --> DBA --> TXA
    RXA --> FSA
  end
  subgraph LAN["LAN confiable TCP 9001 HMAC TLS opcional"]
    CANAL["CREATE_RESUME / DELETE opt-in / ACK"]
  end
  subgraph B["Equipo B"]
    RXB["Receptor TCP"]
    FSB[("Carpeta B")]
    SYNCB["Watchdog + escaneo"]
    DBB[("SQLite: cola + versiones")]
    TXB["Cliente TCP"]
    RXB --> FSB --> SYNCB --> DBB --> TXB
  end
  TXA --> CANAL --> RXB
  TXB --> CANAL --> RXA
