%% Secuencia REAL implementada: envío manual de archivo entre equipos.
sequenceDiagram
  autonumber
  actor Usuario
  participant UI as GUI local
  participant API as FastAPI
  participant TX as Cliente TCP A
  participant RX as Receptor TCP B
  participant DISCO as Disco autorizado B

  Usuario->>UI: Preparar y seleccionar archivo
  UI->>API: POST /api/lan/enviar
  API->>TX: enviar_archivo(...)
  TX->>RX: Conectar por TCP
  opt Token compartido configurado
    TX->>RX: AUTH_INIT
    RX-->>TX: AUTH_CHALLENGE (nonce)
    TX->>RX: AUTH_RESPONSE (HMAC)
    RX-->>TX: ACK autenticado
  end
  TX->>RX: CREATE (ruta, tamaño, SHA-256)
  loop Hasta transferir el tamaño esperado
    TX->>RX: Bloque binario hasta 64 KiB
    RX->>DISCO: Escribir temporal
  end
  RX->>RX: Verificar SHA-256 y conflictos
  alt Válido
    RX->>DISCO: Publicar archivo atómicamente
    RX-->>TX: ACK con ruta y hash
    TX-->>API: Transferencia confirmada
    API-->>UI: Estado exitoso
  else Inválido
    RX->>DISCO: Limpiar temporal
    RX-->>TX: ERROR o cierre
    API-->>UI: Mensaje de error
  end
