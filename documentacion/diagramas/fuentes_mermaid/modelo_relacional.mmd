%% Modelo SQLite existente en src/bd/schema.sql.
%% Las tablas están definidas, pero el motor de envío NO alimenta la cola automáticamente.
erDiagram
  CARPETAS_AUTORIZADAS ||--o{ ARCHIVOS_SINCRONIZADOS : contiene
  ARCHIVOS_SINCRONIZADOS ||--o{ HISTORIAL_VERSIONES : versiones
  ARCHIVOS_SINCRONIZADOS ||--o{ COLA_SINCRONIZACION : eventos
  NODOS_PARES ||--o{ COLA_SINCRONIZACION : destino

  CARPETAS_AUTORIZADAS {
    INTEGER id_carpeta PK
    TEXT ruta_absoluta_linux UK
    TEXT alias_carpeta
    TEXT permisos_posix
    INTEGER sincronizacion_activa
    DATETIME fecha_creacion
  }

  ARCHIVOS_SINCRONIZADOS {
    INTEGER id_archivo PK
    INTEGER id_carpeta FK
    TEXT ruta_relativa
    TEXT hash_sha256
    INTEGER tamano_bytes
    REAL fecha_modificacion
    TEXT estado_actual
    INTEGER es_tombstone
  }

  NODOS_PARES {
    TEXT id_par PK
    TEXT nombre_nodo
    TEXT ip_lan UK
    INTEGER puerto_tcp
    TEXT token_auth_hash
    TEXT estado_autorizacion
    DATETIME ultima_conexion
  }

  HISTORIAL_VERSIONES {
    INTEGER id_version PK
    INTEGER id_archivo FK
    TEXT hash_sha256_previo
    TEXT ruta_respaldo_local
    TEXT origen_nodo
    INTEGER es_conflicto
    DATETIME fecha_registro
  }

  COLA_SINCRONIZACION {
    INTEGER id_operacion PK
    INTEGER id_archivo FK
    TEXT id_par_destino FK
    TEXT tipo_evento
    INTEGER intentos_envio
    TEXT estado_cola
    DATETIME timestamp_evento
  }

  LOGS_AUDITORIA {
    INTEGER id_log PK
    TEXT nivel
    TEXT modulo_origen
    TEXT mensaje_detalle
    TEXT ip_par_asociado
    DATETIME timestamp_log
  }
  %% UNIQUE real en SQL: (id_carpeta, ruta_relativa)
